{
  "name": "lifeboard-backend",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "node --watch -r ts-node/register src/main.ts",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "db:migrate": "node --env-file=.env -r ts-node/register ./node_modules/typeorm/cli.js migration:run -d src/database/data-source.ts",
    "db:revert": "node --env-file=.env -r ts-node/register ./node_modules/typeorm/cli.js migration:revert -d src/database/data-source.ts",
    "db:generate": "node --env-file=.env -r ts-node/register ./node_modules/typeorm/cli.js migration:generate -d src/database/data-source.ts",
    "db:migrate:prod": "node ./node_modules/typeorm/cli.js migration:run -d dist/database/data-source.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  }
}
