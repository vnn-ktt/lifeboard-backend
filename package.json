{
  "name": "lifeboard-backend",
  "version": "0.6.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "node --env-file=.env --watch -r ts-node/register -r tsconfig-paths/register src/main.ts",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "db:migrate": "node --env-file=.env -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d src/database/data-source.ts",
    "db:revert": "node --env-file=.env -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d src/database/data-source.ts",
    "db:generate": "node --env-file=.env -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate -d src/database/data-source.ts",
    "db:migrate:prod": "node ./node_modules/typeorm/cli.js migration:run -d dist/database/data-source.js",
    "test": "node --test --require ts-node/register --require tsconfig-paths/register tests/password.test.ts tests/validation.test.ts tests/goals-validation.test.ts tests/architecture.test.ts tests/routines-validation.test.ts tests/progress-rules.test.ts tests/reviews-validation.test.ts tests/reviews-service.test.ts tests/files.test.ts",
    "files:cleanup": "node --env-file=.env -r ts-node/register -r tsconfig-paths/register src/cli/cleanup-files.ts",
    "files:cleanup:prod": "node dist/cli/cleanup-files.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.28",
    "@nestjs/throttler": "^6.7.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "@aws-sdk/client-s3": "^3.800.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "@types/express": "^5.0.0",
    "tsconfig-paths": "^4.2.0",
    "tsc-alias": "^1.8.16",
    "@types/multer": "^2.0.0"
  }
}
