# Local host configuration (use DB_HOST=db only inside Docker Compose)
NODE_ENV=development
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=lifeboard
DB_PASSWORD=change-me-before-deploy
DB_NAME=lifeboard
DB_POOL_SIZE=10
DB_SSL=false

# Exact origin of the Vue frontend. Never use * with credentialed CORS.
WEB_ORIGIN=http://localhost:8080
# Local HTTP: false; production behind HTTPS: true.
COOKIE_SECURE=false

DB_EXPOSE_PORT=5432
