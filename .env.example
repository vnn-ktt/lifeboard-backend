# Local host configuration (use DB_HOST=db only inside Docker Compose)
NODE_ENV=development
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=lifeboard
DB_PASSWORD=change-me-before-deploy
DB_NAME=lifeboard
DB_POOL_SIZE=10
DB_SSL=false

# Exact origin of the Vue frontend. Never use * with credentialed CORS.
WEB_ORIGIN=http://localhost:8080
# Local HTTP: false; production behind HTTPS: true.
COOKIE_SECURE=false

DB_EXPOSE_PORT=5432

# Storage: local SeaweedFS (see compose.storage.dev.yaml)
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=ru-central1
S3_BUCKET=lifeboard-dev
S3_ACCESS_KEY_ID=lifeboard-dev
S3_SECRET_ACCESS_KEY=lifeboard-local-secret
S3_FORCE_PATH_STYLE=true
