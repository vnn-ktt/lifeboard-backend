          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"ivan@example.com\",\n  \"password\": \"MyStrongPassword123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "2. Set timezone",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
