        "body": {
          "mode": "raw",
          "raw": "{\n  \"timezone\": \"Europe/Amsterdam\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "3. Create numeric daily goal (for immediate test)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/goals",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "goals"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"areaId\": \"finance\",\n  \"title\": \"Savings check-in test\",\n  \"description\": \"Measurable target\",\n  \"horizon\": \"year\",\n  \"target\": 12,\n  \"measurement\": {\n    \"type\": \"numeric\",\n    \"direction\": \"increase\",\n    \"unit\": \"USD\",\n    \"startValue\": 20000,\n    \"targetValue\": 100000\n  },\n  \"checkin\": {\n    \"frequency\": \"daily\",\n    \"fromDate\": \"{{today}}\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code===201) pm.collectionVariables.set(\"goalId\",pm.response.json().id);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "4. Get due queue",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/goal-checkins/due",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "goal-checkins",
            "due"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const all=pm.response.json(); const item=all.find(x=>x.goalId===pm.collectionVariables.get(\"goalId\")); if(item) pm.collectionVariables.set(\"dueDate\",item.dueDate);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "5. Complete UPDATED",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/goals/{{goalId}}/checkins",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "goals",
            "{{goalId}}",
            "checkins"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"dueDate\": \"{{dueDate}}\",\n  \"status\": \"updated\",\n  \"value\": 35000,\n  \"note\": \"Deposit\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code===201 || pm.response.code===200) { const row=pm.response.json(); pm.collectionVariables.set(\"checkinId\",row.id); if(row.metricEntryId) pm.collectionVariables.set(\"metricEntryId\",row.metricEntryId); }"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "6. Retry UPDATED (idempotent)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/goals/{{goalId}}/checkins",
