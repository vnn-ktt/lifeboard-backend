            "url": "{{apiBase}}/users/me/avatar",
            "description": "Requires lifeboard.sid cookie unless register/login.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fileId\": \"{{fileId}}\"\n}",
              "options": {
