    {
      "name": "Files and avatar",
      "item": [
        {
          "name": "Upload image",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{apiBase}}/files",
            "description": "Requires lifeboard.sid cookie unless register/login.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) pm.collectionVariables.set(\"fileId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get image",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{apiBase}}/files/{{fileId}}/content",
            "description": "Requires lifeboard.sid cookie unless register/login."
          }
        },
        {
          "name": "Assign avatar",
          "request": {
            "method": "PUT",
            "header": [
              {
