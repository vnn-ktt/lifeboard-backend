            "body": {
              "mode": "raw",
              "raw": "{\"wins\": \"\", \"obstacles\": \"\", \"nextStep\": \"\", \"mood\": 11}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"ValidationPipe\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "06 Delete review",
          "request": {
            "method": "DELETE",
