    {
      "name": "Reviews",
      "description": "Run in order after Auth Login. Date variables refer to any date in a calendar week; the response weekStart is Monday.",
      "item": [
        {
          "name": "01 Save review (PUT idempotent)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/reviews/{{weekDate}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"wins\": \"Закончил backend v0.5.0\",\n  \"obstacles\": \"Не хватает времени на тестирование\",\n  \"nextStep\": \"Добавить интеграционные тесты\",\n  \"mood\": 8\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Review saved as Monday\", () => { pm.response.to.have.status(200); const r=pm.response.json(); pm.expect(r.weekStart).to.eql(\"2026-11-02\"); pm.expect(r.mood).to.eql(8); pm.expect(r.updatedAt).to.be.a(\"string\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Get review by another day of same week",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/reviews/2026-11-07"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Same week\", () => { pm.response.to.have.status(200); pm.expect(pm.response.json().weekStart).to.eql(\"2026-11-02\") });"
                ]
              }
            }
          ]
        },
        {
          "name": "03 List month (overlapping weeks)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/reviews?from=2026-11-01&to=2026-11-30"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Review history\", () => {pm.response.to.have.status(200); pm.expect(pm.response.json()).to.be.an(\"array\");});"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Update review for same week",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/reviews/2026-11-08",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"wins\": \"Обновил результаты\",\n  \"obstacles\": \"\",\n  \"nextStep\": \"Продолжить проект\",\n  \"mood\": 9\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Upsert update\", () => {pm.response.to.have.status(200);pm.expect(pm.response.json().mood).to.eql(9);});"
                ]
              }
            }
          ]
        },
        {
          "name": "05 Reject invalid mood",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
