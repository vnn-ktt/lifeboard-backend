    "description": "Auth, Areas, Goals, Routines, Progress, Reviews and private S3 files. Log in first; cookies are reused by Postman."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "email",
      "value": "ivan@example.com"
    },
    {
      "key": "password",
      "value": "replace-with-your-existing-password"
    },
    {
      "key": "goalId",
      "value": ""
    },
    {
      "key": "childGoalId",
      "value": ""
    },
    {
      "key": "areaId",
      "value": ""
    },
    {
      "key": "routineId",
      "value": ""
    },
    {
      "key": "checkDate",
      "value": "2026-11-05"
    },
    {
      "key": "weekDate",
      "value": "2026-11-05"
    },
    {
      "key": "fileId",
      "value": ""
