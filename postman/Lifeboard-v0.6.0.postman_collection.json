                "exec": [
                  "pm.test(\"Created\", () => pm.response.to.have.status(201));",
                  "if(pm.response.code === 201) { const r = pm.response.json(); pm.collectionVariables.set(\"routineId\", r.id); pm.test(\"Fields\", () => { pm.expect(r.goalId).to.eql(pm.collectionVariables.get(\"childGoalId\")); pm.expect(r.time).to.eql(\"07:25\"); }); }"
