      "description": "Run after 05 Create child goal, requires childGoalId. Use local date 2026-11-05 for these sample tests. This group deletes the routine at the end.",
      "item": [
        {
          "name": "15 Create routine",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
